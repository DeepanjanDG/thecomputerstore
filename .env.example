# PostgreSQL connection string (local dev: `npm run db:local` starts one on port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thecomputerstore"
# Long random string used to sign session cookies
AUTH_SECRET="replace-with-a-long-random-string"
# Public base URL, used for share links, Open Graph and sitemaps
NEXT_PUBLIC_SITE_URL="https://thecomputerstore.in"
# Admin account created by the seed script
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
NEXT_TELEMETRY_DISABLED=1
